# API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
APP_NAME=MindLens API
APP_VERSION=1.0.0
DEBUG=False

# Security
MAX_FILE_SIZE=10485760
ALLOWED_ORIGINS=https://your-frontend-url.netlify.app

# Rate Limiting
RATE_LIMIT_PER_MINUTE=5

# File Handling
UPLOAD_DIR=uploads
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.txt,.pdf
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,text/plain,application/pdf